{
  "name": "the-covenant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Covenant \u2014 a biblical trading card game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "art:prompts": "node --no-warnings=ExperimentalWarning --experimental-strip-types scripts/art-prompts.mjs",
    "art:status": "node --no-warnings=ExperimentalWarning --experimental-strip-types scripts/art-prompts.mjs --status",
    "art:import": "python3 scripts/import-card-art.py"
  },
  "dependencies": {
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
