# Copy to .env.local (already gitignored) and set this to wherever the
# Covenant TCG Portal is running (e.g. https://covenant-tcg-portal.vercel.app,
# or http://localhost:3000 for local portal development). Signing in is
# mandatory — leaving this blank means the sign-in screen can never
# actually succeed, not that the game falls back to playing without one.
VITE_PORTAL_API_URL=
